rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function sameEmail(email) {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email == email;
    }

    // Public catalog. All mutations happen through trusted server code.
    match /cards/{cardId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Public marketplace listings; only the owner/admin can remove a listing.
    // Creation is intentionally moved to a callable function.
    match /listings/{listingId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Collector profiles are readable, but privileged identity/stat fields are
    // not client-writable. The callable syncProfile function writes these.
    match /profiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Server-owned stats. Clients can read only their own document.
    match /collectorStats/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    // Server-owned notifications. Clients can read their own and mark their own
    // notifications read; creation/update of content is server-only.
    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        resource.data.recipientUid == request.auth.uid || isAdmin()
      );
      allow create, update, delete: if false;
    }

    // User can mark a notification read without changing its content.
    match /notifications/{notificationId} {
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'read']);
    }

    // Trade state is server-authoritative.
    match /tradeRequests/{requestId} {
      allow read: if signedIn() && (
        resource.data.proposerUid == request.auth.uid ||
        resource.data.targetOwnerUid == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    // Orders are created/approved/rejected by trusted server functions.
    match /transactions/{orderId} {
      allow read: if signedIn() && (
        resource.data.userUid == request.auth.uid || isAdmin()
      );
      allow create, update, delete: if false;
    }

    // Auction state and bid history are server-authoritative.
    match /system/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Chat thread metadata and messages: authenticated participants only.
    match /chats/{chatId} {
      function chatParticipant() {
        return signedIn() && (
          request.auth.token.email == resource.data.participantEmails[0] ||
          request.auth.token.email == resource.data.participantEmails[1]
        );
      }

      allow read: if signedIn() && (
        resource.data.participantUids.hasAny([request.auth.uid]) || isAdmin()
      );
      allow create, update: if false;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids.hasAny([request.auth.uid]);
        allow create: if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderUid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
        allow update, delete: if false;
      }
    }

    // Keep other legacy collections locked by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
